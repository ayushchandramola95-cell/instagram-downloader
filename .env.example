# InstaSnap Environment Configuration

# ==========================================
# 1. Self-Hosted yt-dlp Configuration
# ==========================================
# Path to yt-dlp binary (defaults to 'yt-dlp' from your system PATH)
# On Windows, e.g. C:\path\to\yt-dlp.exe
YT_DLP_BINARY_PATH=yt-dlp

# Instagram Cookies (Netscape format file). Essential for bypassing Instagram rate limits / login walls
# You can place cookies.txt in the project root, or specify an absolute path:
YT_DLP_COOKIES_PATH=cookies.txt

# Optional: Rotating Residential Proxy for yt-dlp (e.g. http://user:pass@proxy.example.com:8080)
# Highly recommended for high-traffic production scraping
YT_DLP_PROXY=

# ==========================================
# 2. Third-Party RapidAPI (Optional Backup)
# ==========================================
# If configured, acts as an automatic backup if yt-dlp encounters a temporary block
RAPIDAPI_KEY=
RAPIDAPI_HOST=instagram-downloader-download-instagram-videos-stories1.p.rapidapi.com

# ==========================================
# 3. Direct Session Cookie (Optional Fallback)
# ==========================================
# Instagram session cookie (from browser DevTools > Application > Cookies > sessionid=...)
INSTAGRAM_COOKIE=

# ==========================================
# 4. Security & Anti-Bot Abuse Prevention
# ==========================================
# API Rate Limiting (Requests per minute per IP address)
RATE_LIMIT_FETCH_PER_MIN=30
RATE_LIMIT_DOWNLOAD_PER_MIN=60

# Cloudflare Turnstile Anti-Bot CAPTCHA (Optional)
# Get keys for free from https://dash.cloudflare.com/?to=/:account/turnstile
# If left empty, Turnstile check is automatically bypassed (ideal for local development)
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# ==========================================
PORT=3000

# ==========================================
# 6. Analytics (Google Analytics 4)
# ==========================================
# GA4 Measurement ID (e.g. G-XXXXXXXXXX)
NEXT_PUBLIC_GA_ID=
